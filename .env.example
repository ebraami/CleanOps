# CleanOps Environment Configuration Template
# Copy this file to .env and populate real credentials:
# cp .env.example .env && chmod 600 .env

PORT=8080
GATEWAY_PORT=8080
AGY_PATH=/home/cleanops/.local/bin/agy
WORKSPACE=/cleanops
MAX_CONCURRENT_AGENTS=2

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder_service_role_key_here

# Offsite Backup Configuration
# Options: manual_export | sftp_scp | azure_blob
OFFSITE_DESTINATION_TYPE=manual_export
# OFFSITE_SCP_TARGET=user@remote-server:/path/to/backups
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_BLOB_CONTAINER=cleanops-backups
