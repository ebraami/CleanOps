{
  "info": {
    "name": "CleanOps API",
    "description": "CleanOps backend API collection for Flutter integration. Set the `baseUrl` and `idToken` collection variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{idToken}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "idToken", "value": "<paste_valid_firebase_id_token_here>" }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Create Profile - POST /api/v1/users/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Role is CITIZEN (assigned server-side)', function () {",
                  "    pm.expect(pm.response.json().role).to.eql('CITIZEN');",
                  "});",
                  "pm.test('Name and email are echoed back', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.name).to.eql('Jane Doe');",
                  "    pm.expect(json.email).to.eql('jane@cleanops.org');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Jane Doe\",\n    \"email\": \"jane@cleanops.org\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Creates the profile for the authenticated Firebase user. Expected: 201 Created with role CITIZEN."
          },
          "response": []
        },
        {
          "name": "Get My Profile - GET /api/v1/users/me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns the user profile', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('email');",
                  "    pm.expect(json.role).to.eql('CITIZEN');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Returns the profile of the authenticated user. Expected: 200 OK."
          },
          "response": []
        },
        {
          "name": "Create Profile - Duplicate (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Jane Doe\",\n    \"email\": \"jane@cleanops.org\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Run AFTER 'Create Profile'. A second creation for the same Firebase user must be rejected with 409."
          },
          "response": []
        },
        {
          "name": "Create Profile - Missing Fields (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Jane Doe\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "Body without email must be rejected with 400."
          },
          "response": []
        },
        {
          "name": "Get My Profile - No Token (negative)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Request without token is rejected with 401', function () {",
                  "    pm.expect(pm.response.code).to.eql(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "me"]
            },
            "description": "No Authorization header. Must be rejected with 401 by the Firebase security filter (TASK-4)."
          },
          "response": []
        }
      ]
    }
  ]
}
