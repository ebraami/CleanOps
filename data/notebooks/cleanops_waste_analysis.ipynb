import os
import json
import hashlib
import pandas as pd
import matplotlib.pyplot as plt

# 1. Load Dataset
annotations_path = 'TACO/data/annotations.json'
with open(annotations_path, 'r', encoding='utf-8') as f:
    taco_data = json.load(f)

images_df = pd.DataFrame(taco_data['images'])
annotations_df = pd.DataFrame(taco_data['annotations'])
categories_df = pd.DataFrame(taco_data['categories'])

# Map category IDs to names
category_lookup = dict(zip(categories_df['id'], categories_df['name']))
annotations_df['category_name'] = annotations_df['category_id'].map(category_lookup)

# 2. Comprehensive 60-Category Mapping to CleanOps Core Classes
class_mapping = {
    # Plastic
    'Clear plastic bottle': 'Plastic', 'Other plastic bottle': 'Plastic', 'Plastic bottle cap': 'Plastic',
    'Plastic straw': 'Plastic', 'Other plastic straw': 'Plastic', 'Plastic bag & wrapper': 'Plastic',
    'Plastic film': 'Plastic', 'Styrofoam piece': 'Plastic', 'Other plastic': 'Plastic', 'Polypropylene bag': 'Plastic',
    # Paper/Cardboard
    'Carton': 'Paper/Cardboard', 'Corrugated carton': 'Paper/Cardboard', 'Meal carton': 'Paper/Cardboard',
    'Egg carton': 'Paper/Cardboard', 'Drink carton': 'Paper/Cardboard', 'Paper': 'Paper/Cardboard',
    'Paper cup': 'Paper/Cardboard', 'Tissues': 'Paper/Cardboard', 'Magazine paper': 'Paper/Cardboard',
    # Glass
    'Glass bottle': 'Glass', 'Broken glass': 'Glass', 'Glass cup': 'Glass', 'Glass jar': 'Glass',
    # Metal
    'Drink can': 'Metal', 'Food can': 'Metal', 'Aerosol': 'Metal', 'Aluminum foil': 'Metal',
    'Metal lid': 'Metal', 'Pop tab': 'Metal', 'Scrap metal': 'Metal',
    # Organic/Trash
    'Food waste': 'Organic/Trash', 'Cigarette': 'Organic/Trash', 'Unlabeled litter': 'Organic/Trash'
}

core_classes = ['Plastic', 'Paper/Cardboard', 'Glass', 'Metal', 'Organic/Trash']
annotations_df['cleanops_class'] = annotations_df['category_name'].map(class_mapping).fillna('Organic/Trash')

# 3. Class Counts & Visualization
class_counts = annotations_df['cleanops_class'].value_counts().reindex(core_classes, fill_value=0)

os.makedirs('docs/analytics/figures', exist_ok=True)
plt.figure(figsize=(10, 5))
plt.bar(class_counts.index, class_counts.values, color='#2E7D32')
plt.title('CleanOps Waste Category Distribution')
plt.xlabel('CleanOps Core Class')
plt.ylabel('Number of Annotations (Bounding Boxes)')
plt.grid(axis='y', linestyle='--', alpha=0.3)
plt.tight_layout()
plt.savefig('docs/analytics/figures/waste_categories_barchart.png', dpi=200)
plt.close()

print("Analysis executed successfully. Figure generated.")
